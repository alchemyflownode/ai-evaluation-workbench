# Dependencies
node_modules/

# Build output (regenerate with `npm run build`)
dist/
dist-ssr/
*.local

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tool caches
.vite/
.cache/
*.tsbuildinfo

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Witness runtime artifacts, EXCEPT the committed evidence set.
#
# `witness/*.png` + `witness/witness-report.json` are intentionally tracked: they are
# the behavioural evidence the README cites, and the acceptance criterion about
# traceable findings depends on being able to inspect them. Everything a witness run
# drops *besides* that set is transient.
witness/node_modules/
witness/.cache/
witness/*.trace.zip
witness/trace/

# Local scratch: ad-hoc instrument copies and their reports (leading underscore),
# plus the transient pre-edit backups a careful edit leaves behind.
witness/_*
.fin-backup-*/
*.bak
*.orig
*.rej

